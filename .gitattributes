# Normalize line endings on checkout
* text=auto

# Force Unix LF for scripts and source
*.sh    text eol=lf
*.py    text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Windows scripts keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.wasm  binary
*.bin   binary
*.elf   binary
