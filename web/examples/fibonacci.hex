# Fibonacci: fib[0..19] stored starting at address 0x0100
00000093  # addi x1, x0,  0      # a = 0 (fib[0])
00100113  # addi x2, x0,  1      # b = 1 (fib[1])
10000193  # addi x3, x0, 0x100   # addr = 0x100
01400213  # addi x4, x0, 20      # count = 20
0011a023  # sw   x1,  0(x3)      # mem[addr] = a
00418193  # addi x3, x3,  4      # addr += 4
002082b3  # add  x5, x1, x2      # tmp = a + b
00010093  # addi x1, x2,  0      # a = b
00028113  # addi x2, x5,  0      # b = tmp
fff20213  # addi x4, x4, -1      # count--
fe0214e3  # bne  x4, x0, -24     # if count!=0, goto loop_start
00000013  # nop
00000013  # nop
